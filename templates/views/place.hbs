<div class="details">
  {{#if place.primaryImage.url}}
    <div class="img-header full map-thumbnail" style="
        background: url({{place.primaryImage.url}}) no-repeat center center;
        -webkit-background-size: cover;
        -moz-background-size: cover;
        -o-background-size: cover;
        background-size: cover;
      ">
        <img class="" src="https://maps.googleapis.com/maps/api/staticmap?zoom=13&size=164x164&maptype=roadmap
&markers=color:red%7C{{place.location.geo.[1]}},{{place.location.geo.[0]}}&key=AIzaSyBiseDh4znCfFRoU30MxtB-bhfNMqHHMTw" alt="{{place.title}}" />
    </div>
  {{else}}
    <div class="map-img-wrapper">
      <img class="" src="https://maps.googleapis.com/maps/api/staticmap?zoom=13&size=760x500&maptype=roadmap
&markers=color:red%7C{{place.location.geo.[1]}},{{place.location.geo.[0]}}&key=AIzaSyBiseDh4znCfFRoU30MxtB-bhfNMqHHMTw" alt="{{place.title}}" />
</div>
  {{/if}}
  <!-- Body -->
  <div class="body">
    <!-- Header -->
    <p class="header">{{place.title}}</p>
    <!-- Subheader -->
    <p class="subheader">
      {{#if place.category}}
        {{#each place.category}}
          <span>{{this.title}}</a></span>
        {{/each}}
      {{/if}}
    </p>
    <!-- Actions -->
    {{#if this.user}}
      <div class="actions">
        <a href="/keystone/places/{{place._id}}" class="btn btn-link" target="_blank">Update</a>
      </div>
    {{/if}}
    <!-- Description -->
    {{#if place.description}}
      <p class="description">
        {{place.description}}
      </p>
    {{/if}}
  </div>

</div>
