<div class="details">
  {{#if place.primaryImage.url}}
    <div class="img-header full" style="
        background: url({{place.primaryImage.url}}) no-repeat center center;
        -webkit-background-size: cover;
        -moz-background-size: cover;
        -o-background-size: cover;
        background-size: cover;
      ">
    </div>
  {{/if}}
  <!-- Body -->
  <div class="body">
    <!-- Header -->
    <p class="header">{{place.title}}</p>
    <!-- Actions -->
    {{#if this.user}}
      <div class="actions">
        <a href="/keystone/places/{{place._id}}" class="btn btn-link" target="_blank">Update</a>
      </div>
    {{/if}}
    <!-- Description -->
    {{#if place.description}}
      <p class="description">
        {{place.description}}
      </p>
    {{/if}}
  </div>

</div>
