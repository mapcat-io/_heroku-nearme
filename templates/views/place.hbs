<div class="container">
  <div class="row">
    <div class="col-md-12">
        {{#if place.primaryImage.url}}
          <img class="img-responsive img-full-width" src="{{place.primaryImage.url}}" alt="{{place.title}} image" title="{{place.title}}">
        {{else}}
          <a href="/keystone/places/{{place._id}}" target="_blank"><img class="img-responsive img-full-width" src="http://placehold.it/1024x150?text=" alt="{{this.title}} image" title="{{this.title}}"></a>
        {{/if}}
        <h1>{{place.title}}</h1>
        <p>
          {{#if place.description}}
            {{place.description}}
          {{else}}
            This place doesn't yet have a description. Be the first to <a href="/keystone/places/{{place._id}}" target="_blank">write something nice</a> about it!
          {{/if}}
        </p>
    </div>
  </div>
</div>
