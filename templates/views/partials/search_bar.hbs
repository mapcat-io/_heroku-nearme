<div class="container-fluid search-bar dark-background">
  <div class="row">
      <form>
          <div class="col-xs-9">
              <div class="form-group">
                <input type="text" name="q" class="form-control" id="search-input" value="{{q}}" placeholder="Search for Anything in SF">
              </div>
          </div>
          <div class="col-xs-3">
            <button type="submit" class="btn btn-link">
              <i class="fa fa-search"></i>
            </button>
          </div>
      </form>
  </div>
</div>
