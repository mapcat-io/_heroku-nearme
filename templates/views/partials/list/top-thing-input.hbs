<div data-id="{{ data.id }}" class="row topthing-checkbox-row" style="border-bottom: 1px solid #ddd; padding: 8px 0px 8px 0px;">
  <div class="col-xs-12">
    <div class="checkbox" style="float: left; margin-right: 16px;">
      <label>
        <input type="checkbox" value="{{ data.name }}" name="itemName">
      </label>
    </div>
    <h5 style="text-transform: capitalize;">{{ data.name }}</h5>
    <h5 style="text-transform: capitalize;color:#aaa;font-weight:400;">{{ data.category }}</h5>
  </div>
</div>
