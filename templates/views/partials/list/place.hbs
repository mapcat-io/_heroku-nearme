<div class="row place" data-id="{{ data.id }}" style="cursor: pointer; border-bottom: 1px solid #ddd; padding: 16px 0px 16px 0px;">
  <div class="col-xs-12">
    <h4 style="margin: 0px 0px 4px 0px">{{ data.name }}</h4>
    <h4 style="margin: 0px"><small>{{ data.location.address }}</small></h4>
  </div>
</div>
