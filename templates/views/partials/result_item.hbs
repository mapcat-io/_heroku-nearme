{{#each things}}
  <div class="nm-card" data-id="{{this._id}}">
    <!-- Image Header -->
    {{#if this.primaryImage.url}}
      <div class="img-header full" style="
          background: url({{this.primaryImage.url}}) no-repeat center center;
          -webkit-background-size: cover;
          -moz-background-size: cover;
          -o-background-size: cover;
          background-size: cover;
        ">
      </div>
    {{/if}}
    <!-- Body -->
    <div class="body">
      <!-- Header -->
      <p class="header">{{this.title}}</p>
      <!-- Subheader -->
      <p class="subheader">
        {{#if this.superThing.title}}
          <span>{{this.superThing.title}}</span>
        {{/if}}
        {{#if this.place}}
          {{#each this.place}}
            <span><a href="place/{{this._id}}">@{{this.title}}</a></span>
          {{/each}}
        {{/if}}
      </p>
      <!-- Description -->
      {{#if this.description}}
        <p class="description">
          {{this.description}}
        </p>
      {{/if}}
    </div>
    <!-- Actions -->
    <div class="actions">
      <a href="thing/{{this._id}}" class="btn btn-link">Details</a>
      {{#if ../this.user}}
      <a href="keystone/things/{{this._id}}" class="btn btn-link" target="_blank">Update</a>
      {{/if}}
    </div>
  </div>
{{else}}
  <p>No results.</p>
{{/each}}
