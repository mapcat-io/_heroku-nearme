<div class="details">
  {{#if thing.primaryImage.url}}
    <div class="img-header full" style="
        background: url({{thing.primaryImage.url}}) no-repeat center center;
        -webkit-background-size: cover;
        -moz-background-size: cover;
        -o-background-size: cover;
        background-size: cover;
      ">
    </div>
  {{/if}}
  <!-- Body -->
  <div class="body">
    <!-- Header -->
    <p class="header">{{thing.title}}</p>
    <!-- Subheader -->
    <p class="subheader">
      {{#if thing.superThing.title}}
        <span>{{thing.superThing.title}}</span>
      {{/if}}
      {{#if thing.place}}
        {{#each thing.place}}
          <span><a href="/place/{{this._id}}">@{{this.title}}</a></span>
        {{/each}}
      {{/if}}
    </p>
    <!-- Actions -->
    {{#if this.user}}
      <div class="actions">
        <a href="/keystone/things/{{thing._id}}" class="btn btn-link" target="_blank">Update</a>
      </div>
    {{/if}}
    <!-- Description -->
    {{#if thing.description}}
      <p class="description">
        {{thing.description}}
      </p>
    {{/if}}
  </div>

</div>
